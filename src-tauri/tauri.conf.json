{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "kTeX",
  "version": "../package.json",
  "identifier": "com.kerherve.khervetex",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "node src-tauri/fetch_tectonic.mjs --dev && npm run dev",
    "beforeBuildCommand": "node src-tauri/fetch_tectonic.mjs && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "kTeX",
        "width": 1400,
        "height": 900,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "index.html#splash",
        "title": "kTeX",
        "width": 640,
        "height": 380,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "externalBin": ["binaries/tectonic"],
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ktex", "ktexz", "kdocz"],
        "name": "kTeX document",
        "description": "kTeX document",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Gwilherm Kerherve",
    "shortDescription": "WYSIWYG editor that writes LaTeX",
    "copyright": "Gwilherm Kerherve",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQzg5MUM3RjJERUI0ODEKUldTQnRON3l4NUhJYlk5ZzhyUmFEWkhJakZ0SXFWRG00RjhmVWxHRS9RNlFXUXpvZzZtT2lXeUEK",
      "endpoints": [
        "https://github.com/gkerherve/KherveTeX-React/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
